# === KiroSync 中央 Bot 設定 ===
# 複製成 .env 後填入。

# Discord Bot Token (開發者後台 -> Bot -> Reset Token)
BOT_TOKEN=

# 目標伺服器 (guild) ID
GUILD_ID=

# 放 forum 的「分類」(category) 頻道 ID
CATEGORY_ID=

# 隱藏的 ingest 文字頻道 ID (client 的 webhook 貼到這裡, bot 監聽這裡)
# 留空 = bot 自動建立一個隱藏的 kiro-ingest 頻道並掛 webhook (需 Manage Channels 權限)
INGEST_CHANNEL_ID=

# command 頻道 ID (上下線狀態、webhook URL、slash 指令)
# 留空 = bot 自動建立一個公開的 kiro-command 頻道 (大家可看、可發言, 才能打 slash 指令)
COMMAND_CHANNEL_ID=

# 渲染時是否含工具呼叫/結果 (🔧 toolUse / ↩️ toolResult); 0/false=只貼純文字對話
INCLUDE_TOOLS=1
# 對應關係資料庫檔名 (預設 ks_bot.db, 放在 bot/ 資料夾內)
DB_PATH=ks_bot.db

# --- /summary 用的 Google Gemini API key (https://aistudio.google.com/apikey) ---
# 留空 = /summary 仍可用, 但只出統計卡 (訊息數/工具次數/時間區間), 沒有語意摘要。
GEMINI_API_KEY=
# 摘要用的 model, 逗號或空白分隔 —— 由左至右依序嘗試, 第一個成功的就拿來出摘要
GEMINI_MODELS=gemini-3.1-flash-lite, gemini-2.5-flash-lite, gemma-4-31B

