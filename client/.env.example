# === KiroSync Client 設定 ===
# 複製成 .env 後填入。.env 不要進 git。

# Bot 幫你在 ingest 頻道建的 Webhook URL
WEBHOOK_URL=

# 你的識別名 (bot 用這個分流到你專屬 forum); 留空則用系統使用者名稱
USER_NAME=

# 只同步這些 workspace (cwd), 逗號分隔; 留空 = 全部同步
# 例: SYNC_WORKSPACES=D:\Programs\KiroTest,D:\Work\ProjectX
SYNC_WORKSPACES=

# Kiro session 目錄; 留空自動用 ~/.kiro/sessions/cli
WATCH_DIR=

# 輪詢秒數 (預設 0.7)
POLL_INTERVAL=0.7

# 是否同步工具呼叫/結果 (🔧 toolUse / ↩️ toolResult); 0/false=只同步純文字對話
SYNC_TOOLS=1

# 本地資料庫檔名 (預設 ks_client.db, 放在 client/ 資料夾內)
DB_PATH=ks_client.db
