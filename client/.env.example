# === KiroSync Client 設定 ===
# 複製成 .env 後填入。

# Bot 幫你在 ingest 頻道建的 Webhook URL
WEBHOOK_URL=

# 你的識別名 (bot 用這個分流到你專屬 forum); 留空則用系統使用者名稱
USER_NAME=

# 只同步這些 workspace (cwd), 逗號分隔; 留空 = 全部同步
# 例: SYNC_WORKSPACES=D:\Programs\KiroTest,D:\Work\ProjectX
SYNC_WORKSPACES=

# Kiro session 目錄; 留空自動用 ~/.kiro/sessions/cli
WATCH_DIR=

# 輪詢秒數 (預設 0.7)
POLL_INTERVAL=0.7

# --- 快照上傳調校 (架構 B: client 只傳 raw 快照, bot 端渲染) ---
# 切片上限 MB (Discord 單附件約 25MB, 預設 24; 過大只是片數變多)
SNAP_CHUNK_MB=24
# session 停止變動幾秒後才上傳 (去抖動, 預設 2)
SNAP_DEBOUNCE=2
# 兩次上傳最小間隔秒數 (預設 5)
SNAP_MIN_INTERVAL=5
# 持續變動時, 最遲每幾秒強制上傳一次 (預設 15)
SNAP_MAX_WAIT=15
